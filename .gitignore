logs/
workspace/scratch/
workspace/briefings/
apps/*/dist/
packages/*/dist/
node_modules/
apps/*/node_modules/
packages/*/node_modules/

# The HANDOFF.md convention is retired (see AGENTS.md) — ignored so a stray one
# never goes back under version control.
HANDOFF.md

# Local SQLite databases (vector stores, scratch) — anywhere in the tree.
*.db

# Generated by `wrangler types` — regenerated on demand (pretypecheck/prebuild
# scripts), not committed since it's large and goes stale on every
# wrangler/workerd version bump.
packages/*/worker-configuration.d.ts
packages/*/.wrangler/
apps/*/worker-configuration.d.ts
apps/*/.wrangler/

# Local env files (never committed — see .env.example templates instead)
/.env
/.env.*
!/.env.example
apps/*/.env
packages/*/.env


# cf (the Cloudflare CLI) caches the logged-in account id in the current directory
.cloudflare/
