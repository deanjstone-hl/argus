#!/usr/bin/env bash
# Local CI gate: runs the same checks as .github/workflows/ci.yml, scoped to what
# differs from origin/main. Enable once per clone with
#   git config core.hooksPath .githooks
# On a host with little memory (WSL2, homelab) the gate runs serially, one package at a
# time (argus#36); `CI_SERIAL=0 git push` forces the parallel run.
# Bypass with `git push --no-verify`; GitHub CI still runs the full suite.
set -euo pipefail

# A push that only deletes refs has nothing to check. Each stdin line is
# "<local ref> <local sha> <remote ref> <remote sha>"; a deletion's local sha is
# all zeros.
has_update=false
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  if [[ ! "$local_sha" =~ ^0+$ ]]; then
    has_update=true
  fi
done
if [[ "$has_update" == false ]]; then
  exit 0
fi

exec "$(git rev-parse --show-toplevel)/scripts/ci.sh" --changed
