# Shared myargus Supabase project — same instance as shell/reader/knowledge/stockade
# (passkey auth on the shared cookie domain from links.json; do not create a separate Supabase project)
VITE_SUPABASE_URL=https://<myargus-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Collector/API base, exposed from homelab via Cloudflare Tunnel. The registry owns the
# URL: set this to the output of `bash ../../scripts/links.sh api watchtower-api`
# (the deploy workflow does the same).
VITE_API_BASE_URL=
