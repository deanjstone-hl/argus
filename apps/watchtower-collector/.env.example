# Shared myargus Supabase project — service-role key, never the anon key.
# Pull the real value from Bitwarden at deploy time; never commit .env.
SUPABASE_URL=https://<myargus-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Comma-separated systemd units to poll: user units bare, system units as
# system:<unit>. A timer reports its last trigger and its run's result.
SYSTEMD_UNITS=agent-engine.service,budget-api-cron.timer,system:cloudflared.service

# Syncthing REST API (homelab-local). API key from ~/.config/syncthing/config.xml <apikey>.
SYNCTHING_URL=http://localhost:8384
SYNCTHING_API_KEY=<syncthing-api-key>
# Only when the GUI serves TLS (its self-signed cert names just the device).
# Set both or neither: the cert to pin, and the device name it was issued to.
# SYNCTHING_CA_FILE=/home/<user>/.config/syncthing/https-cert.pem
# SYNCTHING_TLS_SERVERNAME=<device-name>

# Cloudflare (task-004). The read-only "watchtower-collector-cf-read" BWS secret —
# read-only calls only, this collector never writes/deploys with it.
CLOUDFLARE_API_TOKEN=<cloudflare-api-token>
# BWS secret ARGUS_CLOUDFLARE_ACCOUNT_ID: the Cloudflare account id
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECTS=myargus,knowledge,stockade
CLOUDFLARE_WORKER_PROJECTS=reader-api,argus-memory-mcp
# Public-surface cards (argus#687). Every Worker above also gets a
# worker-traffic card from the GraphQL Analytics API: invocations and script
# exceptions with the token as it is, plus edge 4xx/5xx on its route once the
# token has Zone > Analytics: Read on this zone. Endpoint probes and TLS
# expiry for *.myargus.cc need no config.
# BWS secret ARGUS_CLOUDFLARE_ZONE_ID: the myargus.cc zone id
CLOUDFLARE_ZONE_ID=
# Capacity cards (argus#688). D1 databases as name:id (deploy.sh sets it from BWS);
# size comes from GraphQL with the token above. Row counts need Account > D1: Read,
# on that token or a separate one here. D1_LIMIT_MB defaults to Workers Free's 500.
# BWS secret ARGUS_D1_WATCHTOWER_DATABASE_ID: the argus-watchtower database id
D1_DATABASES=argus-watchtower:
# CLOUDFLARE_D1_TOKEN=<cloudflare-api-token-with-d1-read>
# D1_LIMIT_MB=500

# Supabase Management API (task-004). PAT from Bitwarden item "Supabase: Management API PAT"
# (mirrors the sbp_... token also used by the Supabase MCP server).
SUPABASE_MGMT_TOKEN=<supabase-management-api-pat>
SUPABASE_PROJECT_REFS=iyqhnvandyalaujyqbtj,centbxttgyenxtkknepx

# AI coding usage adapter (task-007). Homelab's own ccusage data is read locally, no
# config needed. WSL2/Windows are cross-host — each needs its usage-shim (see
# usage-shim/) reachable over Tailscale, with a matching bearer token from Bitwarden
# item "Watchtower: usage-shim (<host>)". Either pair left unset skips that host.
AI_USAGE_WSL2_URL=http://<wsl2-tailscale-ip>:8765/usage
AI_USAGE_WSL2_TOKEN=<usage-shim-token>
AI_USAGE_WINDOWS_URL=http://<windows-tailscale-ip>:8765/usage
AI_USAGE_WINDOWS_TOKEN=<usage-shim-token>

# Homelab USB printer over IPP, shared by ipp-usb (homelab services/printing/).
# Use localhost, not an IP: the printer answers 400 to an IP-literal host.
PRINTER_IPP_URL=http://localhost:60000/ipp/print

# The same device's scanner over eSCL, on the same ipp-usb port. Read-only.
SCANNER_ESCL_URL=http://localhost:60000/eSCL

# Homelab's self-hosted Actions runners, one card each, from GitHub's runners API.
# A fine-grained PAT with Administration: read on the runners' repos, from BWS
# "watchtower-github-runners-token". Either unset skips the runner cards.
GITHUB_RUNNERS_TOKEN=<github-pat>
GITHUB_RUNNERS=argus/homelab,argus/homelab-2
# GITHUB_OWNER=deanjstone

# LNV-LGN5 host cards (C:, crash dumps, memory, WSL2 units) from the WSL2 usage-shim's
# GET /host, authenticated with AI_USAGE_WSL2_TOKEN.
HOST_REPORT_WSL2_URL=http://<wsl2-tailscale-ip>:8765/host
HOST_REPORT_WSL2_UNITS=agent-engine.service,memory-reconcile.timer

# Main CI per repo and the runner queue wait (repos from GITHUB_RUNNERS), over REST
# with ETag revalidation. A PAT with Actions: read, from BWS
# "myargus GitHub app: collector PAT". Unset skips both.
GITHUB_ACTIONS_TOKEN=<github-pat>
CI_REPOS=argus,argus-config,budget

# Tailnet last-seen cards from homelab's own `tailscale status --json`, as
# name[@offline-after][~companion]. Unset skips them.
TAILSCALE_DEVICES=homelab,LNV-LGN5@12h,lnv-lgn5-wsl@12h~LNV-LGN5,DJ15@7d

# Silent-failure cards (argus#686). Every --user timer here gets judged on
# homelab:timers with no config. Vaults by directory, checked with the
# session-start hook ~/.argus/hooks/vault-staleness.sh (VAULT_STALENESS_HOOK
# overrides it); set VAULT_DIRS empty to turn the cards off.
VAULT_DIRS=/home/<user>/CONTEXT,/home/<user>/CORTEX
# The WSL2 shim's vaults by name, for the lnv-lgn5 vault cards.
HOST_REPORT_WSL2_VAULTS=CONTEXT,CORTEX
# The notice board's queue, with its homelab device token from BWS
# "notice-board-token-homelab". Unset token skips the card.
NOTICE_BOARD_URL=http://127.0.0.1:3790
NOTICE_BOARD_TOKEN=<notice-board-token>
