# Bearer token the homelab collector must present. Generate a random value
# (e.g. `openssl rand -hex 32`) and store it in Bitwarden as
# "Watchtower: usage-shim (<host>)" — one token per host, never shared, never committed.
# BWS secret watchtower-usage-shim-token-wsl2: the bearer token (personal-machine-secrets)
USAGE_SHIM_TOKEN=<random-token>

# Port the shim listens on. Only needs to be reachable over Tailscale, not the public internet.
USAGE_SHIM_PORT=8765

# GET /host — the LNV-LGN5 host report (argus#682). All optional.
# %LOCALAPPDATA% as a WSL path; deploy.sh asks Windows for it.
HOST_LOCALAPPDATA=/mnt/c/Users/<windows-user>/AppData/Local
# The Windows system drive as mounted in WSL2.
HOST_DISK_PATH=/mnt/c
# systemd --user units to report; a timer also reports the service it triggers.
HOST_UNITS=agent-engine.service,memory-reconcile.timer
# The silent-failure cards' parts of GET /host (argus#686). All optional.
# CONTEXT_RECONCILE_HEARTBEAT_FILE=/home/<user>/.argus/memory-reconcile-heartbeat.json
# HOST_VAULT_HOOK=/home/<user>/.argus/hooks/vault-staleness.sh
# HOST_VAULTS=/home/<user>/CONTEXT,/home/<user>/CORTEX
